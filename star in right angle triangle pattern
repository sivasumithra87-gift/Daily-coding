import java.util.Scanner;
public class star {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        System.out.print("Enter the number of rows: ");
        int rows = scanner.nextInt();

    int[] a=new int[rows];
    for(int i=0;i<rows;i++)
    {
        a[i]=i;
    }
    for(int i=0;i<rows;i++)
    {
        for(int j=0;j<=a[i];j++)
        {
            System.out.print("* ");
        }
        System.out.println();
    }
    

    }   
}
